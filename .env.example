# Gemma LLM Configuration
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_MODEL_NAME=gemma-4-31b-it
GEMMA_API_URL=

# Vector Database & Embedding Configuration
# BAAI/bge-large-en-v1.5 produces 1024-dim embeddings — must match Pinecone index dimension
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=claimpilot-index
PINECONE_ENVIRONMENT=us-east-1
PINECONE_DIMENSION=1024
VECTOR_DB_TYPE=pinecone
VECTOR_DB_PATH=./vector_db_data

# Text Chunking Settings
MAX_CHUNK_SIZE=500
CHUNK_OVERLAP=50
